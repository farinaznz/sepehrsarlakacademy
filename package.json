{
  "name": "sepehr-sarlak-academy-next",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "build:standalone": "next build && node scripts/prepare-standalone.mjs",
    "start": "next start",
    "start:standalone": "node .next/standalone/server.js",
    "test": "node --test tests/course-content.test.mjs tests/course-gallery.test.mjs tests/home-hero.test.mjs tests/journal-content.test.mjs",
    "test:integration": "npm run build:standalone && node --test tests/db-health.integration.test.mjs",
    "test:journal": "node --test tests/journal-content.test.mjs",
    "lint": "eslint . --ignore-pattern dist --ignore-pattern .next",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:studio": "drizzle-kit studio",
    "journal:migrate": "node scripts/migrate-journal-content.mjs",
    "course:migrate": "node scripts/migrate-course-content.mjs"
  },
  "dependencies": {
    "drizzle-orm": "0.45.2",
    "next": "16.2.6",
    "postgres": "3.4.8",
    "react": "19.2.6",
    "react-dom": "19.2.6",
    "zod": "4.3.6"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "4.2.1",
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "drizzle-kit": "0.31.10",
    "eslint": "9.39.4",
    "eslint-config-next": "16.2.6",
    "htmlparser2": "^12.0.0",
    "react-server-dom-webpack": "19.2.6",
    "tailwindcss": "4.2.1",
    "typescript": "5.9.3"
  },
  "type": "module"
}
